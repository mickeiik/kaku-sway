# Sway config (Omarchy-style, Tokyo Night)
# Fedora's drop-ins (media keys, brightness...) are still loaded at the bottom;
# files with the same name in ~/.config/sway/config.d/ replace them

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu qs ipc call launcher toggle

### Look
font pango:JetBrains Mono 9
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 2
output * bg ~/Pictures/Wallpapers/tokyo-night.png fill #1a1b26

#                       border  bg      text    indicator child_border
client.focused          #7aa2f7 #292e42 #7aa2f7 #bb9af7   #7aa2f7
client.focused_inactive #1a1b26 #1a1b26 #565f89 #414868   #414868
client.unfocused        #1a1b26 #1a1b26 #565f89 #292e42   #292e42
client.urgent           #f7768e #f7768e #1a1b26 #f7768e   #f7768e
# Title bars only appear in tabbed/stacked layouts: keep them slim and centred
titlebar_border_thickness 0
titlebar_padding 8 3
title_align center

### Behaviour
focus_follows_mouse yes
mouse_warping container
# Split each new window along the longer side (https://github.com/nwg-piotr/autotiling)
exec ~/.local/bin/autotiling

### Apps
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+b exec qs ipc call browser open
bindsym $mod+Alt+b exec qs ipc call browser openPrivate
bindsym $mod+w kill
bindsym $mod+Shift+q kill

### Mouse: Super + left drag = move, Super + right drag = resize
floating_modifier $mod normal

### Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

### Focus / move
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces
# Keycodes = physical number row, so this works on AZERTY and QWERTY (10 = key 1 ... 19 = key 0)
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+15 workspace number 6
bindcode $mod+16 workspace number 7
bindcode $mod+17 workspace number 8
bindcode $mod+18 workspace number 9
bindcode $mod+19 workspace number 10
bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5
bindcode $mod+Shift+15 move container to workspace number 6
bindcode $mod+Shift+16 move container to workspace number 7
bindcode $mod+Shift+17 move container to workspace number 8
bindcode $mod+Shift+18 move container to workspace number 9
bindcode $mod+Shift+19 move container to workspace number 10

### Layout
bindsym $mod+f fullscreen
bindsym $mod+b splith
# $mod+v is paste (config.d/80-clipboard.conf); autotiling makes splitv unneeded
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent
# Not Super+minus: on AZERTY that's the same key as Super+6 (workspace 6)
bindsym $mod+Shift+s move scratchpad
bindsym $mod+s scratchpad show

### Keyboard resize
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
