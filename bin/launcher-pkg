#!/bin/bash
# Package browsers and updates for the launcher (run inside a floating terminal).
#   launcher-pkg install          browse Fedora packages, install the selected ones
#   launcher-pkg remove           browse packages you installed, remove the selected ones
#   launcher-pkg flatpak-install  browse Flathub apps, install the selected ones
#   launcher-pkg flatpak-remove   browse installed Flatpak apps, remove the selected ones
#   launcher-pkg update           update the system (dnf) and Flatpak apps
#   launcher-pkg firmware         update BIOS and device firmware (fwupd)
#   launcher-pkg voxtype-check    print "voxtype" if a newer voxtype is out (for the bar)
#   launcher-pkg voxtype-update   install voxtype, or update it if a newer one is out

# Tokyo Night, square borders
FZF_THEME=(
    --border=sharp --preview-window=down,55%,border-top,wrap
    --color='fg:#c0caf5,bg:-1,hl:#7aa2f7,fg+:#c0caf5,bg+:#292e42,hl+:#7aa2f7'
    --color='info:#565f89,prompt:#7aa2f7,pointer:#7aa2f7,marker:#9ece6a,spinner:#7aa2f7,header:#565f89,border:#414868'
    --marker='+' --pointer='>' --multi --reverse --ansi
)

# fzf over "id<TAB>label" lines; prints the selected ids
pick() {
    local prompt=$1 preview=$2
    fzf "${FZF_THEME[@]}" --prompt="$prompt › " --delimiter=$'\t' --with-nth=2.. \
        --header='Tab: select several   Enter: confirm   Esc: cancel' \
        --preview="$preview" | cut -f1
}

# Adds a green ✓ to "id<TAB>label" lines whose id is in the list given as $1
mark_installed() {
    awk -F'\t' -v OFS='\t' -v inst="$1" '
        BEGIN { n = split(inst, a, "\n"); for (i = 1; i <= n; i++) have[a[i]] = 1 }
        { if ($1 in have) $2 = $2 "  \033[32m✓\033[0m"; print }'
}

heading() {
    echo -e "\n\033[1;34m== $*\033[0m"
}

# voxtype (speech to text) isn't in Fedora's repos, so dnf doesn't update it: it comes
# from its GitHub releases. Major version pinned (kaku-sway uses its state file, output
# hooks and record commands): only stable 1.x releases.
VOXTYPE_MAJOR=1

# Prints "version<TAB>RPM url" of the newest stable voxtype release, nothing offline
voxtype_release() {
    curl -fsSL --max-time 15 "https://api.github.com/repos/peteonrails/voxtype/releases?per_page=30" |
        jq -r --arg re "^v${VOXTYPE_MAJOR}\\.[0-9]+\\.[0-9]+$" '
            [.[] | select(.draft == false and .prerelease == false and (.tag_name | test($re)))] | first // empty
            | [(.tag_name | ltrimstr("v")),
               ([.assets[] | select(.name | test("^voxtype-.*\\.x86_64\\.rpm$")) | .browser_download_url] | first // empty)]
            | select(.[1] != "") | @tsv' 2>/dev/null
}

# True if version $1 is newer than the installed voxtype (or voxtype isn't installed)
voxtype_newer() {
    local installed
    installed=$(rpm -q --qf '%{VERSION}' voxtype 2>/dev/null) || return 0
    [ "$1" != "$installed" ] && [ "$(printf '%s\n%s\n' "$1" "$installed" | sort -V | tail -1)" = "$1" ]
}

voxtype_update() {
    local version url rpm_file
    IFS=$'\t' read -r version url < <(voxtype_release)
    if [ -z "$url" ]; then
        echo "Couldn't reach GitHub to check voxtype"
        return 1
    fi
    if ! voxtype_newer "$version"; then
        echo "voxtype $version is up to date"
        return 0
    fi
    rpm_file=$(mktemp --suffix=.rpm)
    curl -fL -o "$rpm_file" "$url" && sudo dnf install -y "$rpm_file"
    local status=$?
    rm -f "$rpm_file"
    # The daemon keeps running the old binary until restarted
    [ $status -eq 0 ] && systemctl --user try-restart voxtype
    return $status
}

finish() {
    echo
    read -rsn1 -p "Done. Press any key to close."
}

# The browsers need fzf: say so instead of closing straight away
if [[ $1 == install || $1 == remove || $1 == flatpak-* ]] && ! command -v fzf >/dev/null; then
    echo "fzf is not installed. Install it with:"
    echo
    echo "    sudo dnf install fzf"
    finish
    exit 1
fi

case "$1" in
    install)
        mapfile -t pkgs < <(
            { dnf repoquery --available --cacheonly --qf '%{name}\n' 2>/dev/null || dnf repoquery --available --qf '%{name}\n'; } |
                sort -u | awk '{ printf "%s\t%s\n", $0, $0 }' | mark_installed "$(rpm -qa --qf '%{NAME}\n')" |
                pick "Install (Fedora)" 'dnf info --cacheonly {1} 2>/dev/null || dnf info {1}')
        [ ${#pkgs[@]} -eq 0 ] && exit 0
        sudo dnf install -- "${pkgs[@]}"
        ;;
    remove)
        mapfile -t pkgs < <(
            dnf repoquery --userinstalled --qf '%{name}\n' 2>/dev/null | sort -u | awk '{ printf "%s\t%s\n", $0, $0 }' |
                pick "Remove (Fedora)" 'dnf info --installed {1}')
        [ ${#pkgs[@]} -eq 0 ] && exit 0
        sudo dnf remove -- "${pkgs[@]}"
        ;;
    flatpak-install)
        # App list with descriptions, kept for the details pane
        catalog=$(mktemp); trap 'rm -f "$catalog"' EXIT
        flatpak remote-ls --user --app --columns=application,name,version,description flathub 2>/dev/null > "$catalog"
        details="awk -F'\t' -v id={1} '\$1 == id { print \"\033[1m\" \$2 \"\033[0m  \" \$3; print \"\"; print \$4; print \"\" }' $catalog;
                 flatpak remote-info --user flathub {1} | grep -E 'ID:|Download Size|Installed Size|Runtime'"
        mapfile -t apps < <(
            sort -t$'\t' -k2 -f "$catalog" |
                awk -F'\t' '{ printf "%s\t%s  \033[90m%s\033[0m\n", $1, $2, $1 }' |
                mark_installed "$(flatpak list --app --columns=application)" |
                pick "Install (Flathub)" "$details")
        [ ${#apps[@]} -eq 0 ] && exit 0
        # No -y: Flatpak shows the permissions each app asks for and waits for "y"
        flatpak install --user flathub "${apps[@]}"
        ;;
    flatpak-remove)
        mapfile -t apps < <(
            flatpak list --app --columns=application,name | sort -t$'\t' -k2 -f |
                awk -F'\t' '{ printf "%s\t%s  \033[90m%s\033[0m\n", $1, $2, $1 }' |
                pick "Remove (Flatpak)" 'flatpak info {1}')
        [ ${#apps[@]} -eq 0 ] && exit 0
        flatpak uninstall -y -- "${apps[@]}"
        ;;
    update)
        heading "System packages (dnf)"
        sudo dnf upgrade --refresh
        heading "Flatpak apps"
        # No -y: updates that ask for new permissions are shown and wait for "y"
        flatpak update
        # Only if it's installed: it may have been removed on purpose
        if rpm -q voxtype >/dev/null 2>&1; then
            heading "Speech to text (voxtype, from GitHub)"
            voxtype_update
        fi
        ;;
    firmware)
        heading "Firmware (fwupd)"
        fwupdmgr refresh --force
        fwupdmgr update
        ;;
    voxtype-check)
        IFS=$'\t' read -r version url < <(voxtype_release)
        rpm -q voxtype >/dev/null 2>&1 && [ -n "$url" ] && voxtype_newer "$version" && echo voxtype
        exit 0
        ;;
    voxtype-update)
        voxtype_update
        exit
        ;;
    *)
        # Usage: the "launcher-pkg ..." lines of the header above
        sed -n 's/^#   \(launcher-pkg .*\)/\1/p' "$0"
        exit 1
        ;;
esac
finish
